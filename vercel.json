{
  "version": 2,
  "buildCommand": "npm run build:all",
  "installCommand": "npm install && cd frontend && npm install && cd ../backend && npm install",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
